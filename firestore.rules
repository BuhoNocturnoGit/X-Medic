rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección de usuarios
    match /users/{userId} {
      // El usuario autenticado puede leer su propio perfil
      allow read: if request.auth != null && request.auth.uid == userId;

      // Permitir crear el perfil inicial si no contiene campos económicos administrados por el backend
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['tokens', 'tokensInitialized', 'tokensInitializedAt', 'tokensUpdatedAt']);

      // Permitir actualizar campos del perfil (displayName, email, role, onboardingCompleted)
      // PERO BLOQUEAR TOTALMENTE cualquier modificación sobre los campos económicos desde el cliente Android.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tokens', 'tokensInitialized', 'tokensInitializedAt', 'tokensUpdatedAt']);

      allow delete: if false; // Los perfiles de usuario no se eliminan desde el cliente Android.
    }

    // Colecciones de auditoría y transacciones (Sólo accesibles por el Backend Worker)
    match /token_transactions/{txId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /analysis_operations/{opId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /ad_rewards/{rewardId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /ad_sessions/{sessId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
