    "firebase",
    "firestore",
    "admob-ssv",
    "xmedic"
  ],
  "author": "XMedic Team",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "wrangler": "^3.86.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
